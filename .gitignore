# ============================================================
# ML + Quants Trading Agent — .gitignore
# ============================================================

# --- Python ---
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
*.egg
dist/
build/
*.whl

# --- Virtual Environments ---
.venv/
venv/
env/
ENV/

# --- IDE ---
.vscode/
.idea/
*.swp
*.swo
*~

# --- Environment / Secrets ---
.env
*.env
!.env.example

# --- Jupyter Notebooks Checkpoints ---
.ipynb_checkpoints/

# --- Data (large files, raw market data) ---
data/raw/
data/processed/
data/external/
*.csv
!data/universe/*.csv
*.parquet
*.h5
*.hdf5
*.feather
*.pkl
*.pickle

# --- Model Artifacts ---
# Individual heavy binaries ignored; JSON models & directories preserved
*.pt
*.pth
*.onnx
*.joblib
*.bin
checkpoints/

# --- Logs ---
logs/
*.log

# --- Testing & Coverage ---
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini

# --- Streamlit ---
.streamlit/secrets.toml

# --- Misc ---
*.bak
*.tmp
*.temp
