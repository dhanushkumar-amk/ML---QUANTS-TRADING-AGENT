# ==============================================================================
# ML + Quants Trading Agent — Environment Variables (.env.example)
# ==============================================================================
# Copy this template to .env:
#   cp .env.example .env
#
# IMPORTANT SECURITY NOTICE:
# - NEVER commit your .env file to version control (it is strictly git-ignored).
# - This project uses the ALPACA PAPER TRADING sandbox by default.
# - Do NOT use live trading credentials with real capital.
# ==============================================================================

# --- Alpaca Paper Trading Broker Rail ---
# Register free at https://alpaca.markets/ to generate paper trading credentials
ALPACA_API_KEY=your_alpaca_paper_api_key_here
ALPACA_SECRET_KEY=your_alpaca_paper_secret_key_here
# Paper endpoint (default):
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# --- Market Data & Alternative Feeds (Optional / Mockable) ---
POLYGON_API_KEY=your_polygon_io_api_key_here
FINNHUB_API_KEY=your_finnhub_api_key_here
NEWS_API_KEY=your_news_api_key_here

# --- System & Logging ---
LOG_LEVEL=INFO
FASTAPI_PORT=8000
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
